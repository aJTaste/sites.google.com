{
  "rewrites":[
    {
      "source":"/bare/:path*",
      "destination":"https://uv-bare.onrender.com/:path*"
    }
  ],
  "headers":[
    {
      "source":"/uv/(.*).js",
      "headers":[
        {
          "key":"Content-Type",
          "value":"application/javascript"
        },
        {
          "key":"Service-Worker-Allowed",
          "value":"/"
        }
      ]
    },
    {
      "source":"/uv/service/(.*)",
      "headers":[
        {
          "key":"Cross-Origin-Embedder-Policy",
          "value":"require-corp"
        },
        {
          "key":"Cross-Origin-Opener-Policy",
          "value":"same-origin"
        }
      ]
    }
  ]
}
