{
  "rewrites":[
    {
      "source":"/bare/:path*",
      "destination":"https://uv-bare.onrender.com/:path*"
    }
  ],
  "headers":[
    {
      "source":"/sites.google.com/uv/uv.sw.js",
      "headers":[
        {
          "key":"Content-Type",
          "value":"application/javascript; charset=utf-8"
        },
        {
          "key":"Service-Worker-Allowed",
          "value":"/"
        },
        {
          "key":"Cache-Control",
          "value":"no-cache"
        }
      ]
    },
    {
      "source":"/sites.google.com/uv/service/(.*)",
      "headers":[
        {
          "key":"Cross-Origin-Embedder-Policy",
          "value":"require-corp"
        },
        {
          "key":"Cross-Origin-Opener-Policy",
          "value":"same-origin"
        }
      ]
    }
  ]
}
